<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Interpretación IA - El I Chingón</title>
<style>
  :root { color-scheme: dark; }
  *, *::before, *::after { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

  html, body {
    width: 100%;
    min-height: 100%;
    background-color: #080a0f !important;
    color: #ee5 !important;
    font-family: system-ui, -apple-system, sans-serif;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 16px;
    margin: 0;
  }

  .modal-wrapper {
    width: 100%;
    max-width: 480px;
    background: rgba(20, 20, 20, 0.95);
    border: 1px solid #333;
    padding: 24px;
    border-radius: 4px;
    box-sizing: border-box;
  }

  .title { font-size: 1.2rem; margin: 0 0 6px 0; text-align: center; color: #fff; }
  .subtitle { font-size: 0.8rem; color: #888; text-align: center; margin-bottom: 20px; line-height: 1.4; }

  .form-group { margin-bottom: 16px; }
  .form-label { display: block; font-size: 0.85rem; color: #ccc; margin-bottom: 6px; }
  
  .form-textarea {
    width: 100%;
    height: 110px;
    padding: 10px;
    background: #111;
    border: 1px solid #444;
    color: #fff;
    font-size: 0.88rem;
    border-radius: 2px;
    box-sizing: border-box;
    font-family: inherit;
    resize: vertical;
  }
  .form-textarea:focus, .form-input:focus { border-color: var(--app-accent, #eeee55); outline: none; }

  .form-input {
    width: 100%;
    padding: 10px;
    background: #111;
    border: 1px solid #444;
    color: #fff;
    font-size: 0.9rem;
    border-radius: 2px;
    box-sizing: border-box;
    font-family: inherit;
  }

  .help-box {
    font-size: 0.75rem;
    color: #999;
    background: rgba(255, 255, 255, 0.03);
    border-left: 2px solid #555;
    padding: 8px 10px;
    margin-top: 6px;
    line-height: 1.4;
  }
  .help-box strong { color: #bbb; }

  .checkbox-group {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.8rem;
    color: #aaa;
    margin: 16px 0;
    cursor: pointer;
  }
  .checkbox-group input { margin-top: 2px; cursor: pointer; }

  .btn-action {
    width: 100%;
    padding: 12px;
    background: #222;
    border: 1px solid var(--app-accent, #eeee55);
    color: #fff;
    font-size: 0.88rem;
    cursor: pointer;
    border-radius: 2px;
    transition: background 0.2s;
    box-sizing: border-box;
    font-weight: 500;
  }
  .btn-action:hover { background: rgba(238, 238, 85, 0.15); }
  .btn-action:disabled { border-color: #444; color: #666; background: #111; cursor: not-allowed; }

  /* Contenedor del Estado de Carga (Video de la Vela) */
  #loadingState {
    display: none;
    text-align: center;
    padding: 10px 0;
  }
  .loading-video {
    width: 100%;
    max-width: 320px;
    border-radius: 4px;
    border: 1px solid #444;
    margin: 0 auto 14px auto;
    display: block;
  }
  .loading-text {
    font-size: 0.85rem;
    color: #ccc;
    animation: pulse 2s infinite ease-in-out;
  }
  @keyframes pulse {
    0%, 100% { opacity: 0.6; }
    50% { opacity: 1; }
  }

  .error-msg {
    color: #ff6b6b;
    font-size: 0.78rem;
    margin-top: 6px;
    display: none;
  }
</style>
</head>
<body>

<div class="modal-wrapper">
  
  <!-- VISTA 1: Formulario de Solicitud de IA -->
  <div id="aiFormContainer">
    <h1 class="title" id="lblTitle">Interpretación Asistida por IA</h1>
    <p class="subtitle" id="lblSubtitle">Conecta el oráculo con la realidad de tu pregunta a través del motor de 黛靈娜 (Costo: 1 Crédito).</p>

    <form id="aiRequestForm" onsubmit="window.enviarSolicitudIA(event)">
      
      <div class="form-group">
        <label class="form-label" id="lblContextTitle">Contexto detallado de tu situación:</label>
        <textarea id="userContext" class="form-textarea" required placeholder="Ej: Estoy evaluando cambiar de empleo pero me preocupa la estabilidad familiar..."></textarea>
        
        <div class="help-box" id="helpBoxText">
          <strong>💡 Tip para una mejor lectura:</strong> Evita preguntas vagas como <em>"¿Me irá bien?"</em>. Describe emociones, dilemas o personas involucradas para que la IA traduzca con precisión los textos arcaicos a tu realidad.
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" id="lblCodeTitle">Código de Gift Card:</label>
        <input type="text" id="giftCode" class="form-input" required autocomplete="off" placeholder="Ej: DAILINGNA-XXXX-XXXX">
        <div id="codeError" class="error-msg"></div>
      </div>

      <label class="checkbox-group">
        <input type="checkbox" id="acceptTerms" required>
        <span id="lblTerms">Acepto los <a href="/terminos/" target="_blank" style="color: var(--app-accent, #eeee55);">Términos de Servicio</a> y las políticas de uso del oráculo.</span>
      </label>

      <button type="submit" class="btn-action" id="btnSubmitAi">
        ✨ Consultar a la IA (1 Crédito)
      </button>
    </form>
  </div>

  <!-- VISTA 2: Estado de Trance / Carga (Video de la Vela) -->
  <div id="loadingState">
    <!-- Video en bucle de las manos de Dailingna sobre el libro y la vela[cite: 2] -->
    <video class="loading-video" autoplay loop muted playsinline>
      <source src="/video/hidden_dragon.mp4" type="video/mp4">
    </video>
    <div class="loading-text" id="lblLoadingText">
      黛靈娜 está contemplando las líneas... Por favor, no cierres ni actualices esta ventana.
    </div>
  </div>

</div>

<script>
(() => {
  const urlParams = new URLSearchParams(window.location.search);
  const lang = urlParams.get('lang') || 'es';

  // Textos localizados básicos para el modal
  const i18nTexts = {
    es: {
      title: "Interpretación Asistida por IA",
      subtitle: "Conecta el oráculo con la realidad de tu pregunta a través de la traducción inteligente (Costo: 1 Crédito).",
      contextTitle: "Contexto detallado de tu situación:",
      contextPlaceholder: "Ej: Estoy evaluando cambiar de empleo pero me preocupa la estabilidad familiar...",
      tip: "<strong>💡 Tip para una mejor lectura:</strong> Evita preguntas vagas como <em>\"¿Me irá bien?\"</em>. Describe emociones o dilemas reales para que la IA traduzca con precisión los textos arcaicos.",
      codeTitle: "Código de Gift Card:",
      terms: 'Acepto los <a href="/terminos/" target="_blank" style="color: var(--app-accent, #eeee55);">Términos de Servicio</a> y las políticas de uso.',
      btn: "✨ Consultar a la IA (1 Crédito)",
      loading: "黛靈娜 está contemplando las líneas... Por favor, no cierres ni actualices esta ventana.",
      errInvalid: "El código de Gift Card no es válido o está inactivo.",
      errDepleted: "La Gift Card no tiene créditos disponibles.",
      errComplexity: "La consulta superó la complejidad estimada. Se ha derivado al servicio humano.",
      errServer: "Ocurrió un error en el servidor. Inténtalo de nuevo."
    },
    en: {
      title: "AI-Assisted Interpretation",
      subtitle: "Connect the oracle to the reality of your question through intelligent translation (Cost: 1 Credit).",
      contextTitle: "Detailed context of your situation:",
      contextPlaceholder: "E.g.: I am considering changing jobs but I worry about family stability...",
      tip: "<strong>💡 Tip:</strong> Avoid vague questions like <em>\"Will I succeed?\"</em>. Describe real emotions or dilemmas so the AI accurately translates archaic texts.",
      codeTitle: "Gift Card Code:",
      terms: 'I accept the <a href="/terminos/" target="_blank" style="color: var(--app-accent, #eeee55);">Terms of Service</a> and usage policies.',
      btn: "✨ Consult AI (1 Credit)",
      loading: "黛靈娜 is contemplating the lines... Please do not close or refresh this window.",
      errInvalid: "The Gift Card code is invalid or inactive.",
      errDepleted: "The Gift Card has no available credits.",
      errComplexity: "The query exceeded expected complexity. It has been redirected to human support.",
      errServer: "A server error occurred. Please try again."
    },
    de: {
      title: "KI-gestützte Interpretation",
      subtitle: "Verbinde das Orakel durch intelligente Übersetzung mit der Realität deiner Frage (Kosten: 1 Credit).",
      contextTitle: "Detaillierter Kontext deiner Situation:",
      contextPlaceholder: "Z.B.: Ich erwäge einen Jobwechsel, mache mir aber Sorgen um die familiäre Stabilität...",
      tip: "<strong>💡 Tipp:</strong> Vermeide vage Fragen wie <em>\"Werde ich Erfolg haben?\"</em>. Beschreibe reale Emotionen oder Dilemmata.",
      codeTitle: "Gift Card Code:",
      terms: 'Ich akzeptiere die <a href="/terminos/" target="_blank" style="color: var(--app-accent, #eeee55);">Nutzungsbedingungen</a>.',
      btn: "✨ KI konsultieren (1 Credit)",
      loading: "黛靈娜 betrachtet die Linien... Bitte schließe oder aktualisiere dieses Fenster nicht.",
      errInvalid: "Der Gift Card Code ist ungültig oder inaktiv.",
      errDepleted: "Die Gift Card hat keine verfügbaren Credits mehr.",
      errComplexity: "Die Abfrage hat die Komplexitätsschwelle überschritten.",
      errServer: "Ein Serverfehler ist aufgetreten. Bitte versuche es erneut."
    }
  };

  const t = i18nTexts[lang] || i18nTexts.es;

  // Aplicar traducciones estáticas al DOM del modal
  document.getElementById('lblTitle').innerText = t.title;
  document.getElementById('lblSubtitle').innerText = t.subtitle;
  document.getElementById('lblContextTitle').innerText = t.contextTitle;
  document.getElementById('userContext').placeholder = t.contextPlaceholder;
  document.getElementById('helpBoxText').innerHTML = t.tip;
  document.getElementById('lblCodeTitle').innerText = t.codeTitle;
  document.getElementById('lblTerms').innerHTML = t.terms;
  document.getElementById('btnSubmitAi').innerText = t.btn;
  document.getElementById('lblLoadingText').innerText = t.loading;

  // Manejo del envío hacia el Cloudflare Worker
  window.enviarSolicitudIA = async function(e) {
    e.preventDefault();

    const contextVal = document.getElementById('userContext').value.trim();
    const codeVal = document.getElementById('giftCode').value.trim();
    const errorDiv = document.getElementById('codeError');
    errorDiv.style.display = 'none';

    // Recuperar los datos de la tirada actual almacenados en sessionStorage por el generador de entropía
    let rawTirada = {};
    try {
      rawTirada = JSON.parse(sessionStorage.getItem('lastHexagram') || '{}');
    } catch (err) {}

    if (!rawTirada.hexagram) {
      alert("No se encontró una tirada activa. Por favor realiza el ritual de entropía primero.");
      return;
    }

    // Ocultar formulario y mostrar la animación de la vela (video)[cite: 2]
    document.getElementById('aiFormContainer').style.display = 'none';
    document.getElementById('loadingState').style.display = 'block';

    const payload = {
      code: codeVal,
      question: contextVal,
      resulting_hexagram: rawTirada.hexagram,
      moving_lines: rawTirada.changingLines || [],
      future_hexagram: rawTirada.derivedHexagram || null,
      language: lang,
      pais: "VE", // O el país detectado
      metodo: rawTirada.method || "monedas",
      modo: rawTirada.mode || "progressive"
    };

    try {
      const response = await fetch('/', { // Apunta a tu Worker backend
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const result = await response.json();

      if (result.success) {
        // Comunicar éxito al single.html principal
        window.parent.postMessage({ type: 'AI_INTERPRETATION_SUCCESS', data: result }, '*');
      } else {
        // Manejar errores devueltos por el Worker
        document.getElementById('loadingState').style.display = 'none';
        document.getElementById('aiFormContainer').style.display = 'block';

        let msg = t.errServer;
        if (result.error === 'gift_card_invalid') msg = t.errInvalid;
        else if (result.error === 'gift_card_depleted') msg = t.errDepleted;
        else if (result.error === 'exceeded_complexity') msg = t.errComplexity;

        errorDiv.textContent = msg;
        errorDiv.style.display = 'block';
      }

    } catch (err) {
      document.getElementById('loadingState').style.display = 'none';
      document.getElementById('aiFormContainer').style.display = 'block';
      errorDiv.textContent = t.errServer;
      errorDiv.style.display = 'block';
    }
  };
})();
</script>

</body>
</html>